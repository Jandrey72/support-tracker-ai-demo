# ==========================================================
#  Support Tracker AI - Variables de entorno
#  Copia este archivo como ".env" y rellena tus valores.
# ==========================================================

# --- Base de datos ---
# Para el MVP usamos SQLite (un archivo local, sin servidor).
# El dia que quieras PostgreSQL, cambias esto y el provider en prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Proveedor de IA ---
# Opciones: claude | openai | gemini | deepseek | groq
AI_PROVIDER=groq

# Solo necesitas la llave del proveedor que elijas arriba.
CLAUDE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# (Opcional) Modelo a usar por proveedor. Si lo dejas vacio se usa uno economico.
# CLAUDE_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# DEEPSEEK_MODEL=deepseek-chat
# GROQ_MODEL=openai/gpt-oss-120b   (groq/compound y llama-3.3 ya no existen desde sep-2026)

# --- Ajustes del analisis ---
# Confianza minima (0 a 1) para registrar un soporte automaticamente.
MIN_CONFIDENCE=0.6

# --- WhatsApp ---
# Opcional: nombres de grupos a monitorear, separados por coma.
# Si lo dejas vacio, el bot monitorea TODOS los grupos donde este.
MONITORED_GROUPS=

# --- Logs ---
# Opciones: error | warn | info | debug
LOG_LEVEL=info

# --- Alertas de monitoreo (Zabbix) ---
# Token que debe mandar Zabbix para poder publicar alertas por WhatsApp.
# Si lo dejas vacio, el endpoint /api/alertas/zabbix queda apagado.
# Genera uno con: openssl rand -hex 24
ZABBIX_TOKEN=

# --- Vigilancia de Zabbix ---
# El bot consulta Zabbix cada tantos segundos y publica los problemas nuevos
# (y avisa cuando se resuelven). Si dejas estas dos vacias, queda apagado.
ZABBIX_URL=
ZABBIX_TOKEN_API=
# Cada cuanto preguntar, en segundos (minimo 30).
ZABBIX_POLL_SECONDS=120
# Severidad minima: 0 No clasificada · 1 Informativa · 2 Advertencia
#                   3 Promedio · 4 Alta · 5 Desastre
ZABBIX_MIN_SEVERITY=3
# Equipos a vigilar (coma). Basta un pedazo del nombre. Vacio = todos.
ZABBIX_HOSTS=
# Grupo del CLIENTE donde publicar ademas un aviso en lenguaje llano.
# Vacio = solo al grupo interno. Ejemplo: 5210000000000-1600000000@g.us
# Seguimiento mientras dura un corte de energia, en minutos (0 = apagado)
ZABBIX_SEGUIMIENTO_MINUTOS=10
ZABBIX_GRUPO_CLIENTE=

# --- Dashboard web ---
# Puerto donde abrir el dashboard (http://localhost:PUERTO)
PORT=3000

# --- Avisos al grupo interno ---
# Aviso "Nuevo soporte" por cada ticket (ruidoso). El responsable igual recibe su privado.
AVISO_POR_TICKET=false
# Donde se avisa que alguien salio/volvio: privado (a los otros tecnicos) | grupo | off
AVISO_AUSENCIA=privado
# Horas ausente antes de que el bot te recuerde por privado (0 = nunca)
AUSENCIA_RECORDATORIO_HORAS=4
# Horas de silencio para ese recordatorio (no se manda de noche). 21 a 8 = de 9 p. m. a 8 a. m.
AUSENCIA_SILENCIO_DESDE=21
AUSENCIA_SILENCIO_HASTA=8
# Resumen semanal: dia 0=domingo 1=lunes ... 6=sabado, hora 0-23 (hora local del servidor)
RESUMEN_SEMANAL=true
RESUMEN_DIA=1
RESUMEN_HORA=9
# Resumen diario (lunes a sabado): pendientes de cada quien y vencidos de SLA
RESUMEN_DIARIO=true
RESUMEN_DIARIO_HORA=9
# Reporte mensual en PDF por cliente, el dia 1, al grupo INTERNO (para revisarlo)
REPORTE_MENSUAL=true
REPORTE_MENSUAL_HORA=9
# Problemas repetidos: N soportes de la misma categoria en la misma empresa en X dias
REPETIDOS_MINIMO=3
REPETIDOS_DIAS=30
