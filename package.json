{
  "name": "support-tracker-ai",
  "version": "0.1.0",
  "description": "Bot de WhatsApp que detecta y registra soportes tecnicos automaticamente con IA",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --include .env src/index.ts",
    "dashboard": "tsx watch --include .env src/web-only.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "enrich": "tsx src/scripts/enrichSupports.ts",
    "pass": "tsx src/scripts/generatePassword.ts",
    "zabbix:items": "tsx src/scripts/zabbixItems.ts",
    "backfill:tickets": "tsx src/scripts/backfillTicketNumbers.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pdfkit": "^0.19.1",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
  
} 

